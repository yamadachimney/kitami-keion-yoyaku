{
  "rules": {
    ".read": false,
    ".write": false,
    "weeks": {
      ".read": true,
      "$w": {
        "cfg": {
          ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'",
          ".validate": "newData.hasChildren(['phase','order','maxSlots'])",
          "phase": {
            ".validate": "newData.val() === 'closed' || newData.val() === 'request' || newData.val() === 'free'"
          },
          "maxSlots": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24"
          },
          "order": {
            ".validate": "newData.hasChildren(['0','1','2'])"
          },
          "$other": {
            ".validate": false
          }
        },
        "reqs": {
          "$id": {
            ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (!data.exists() && newData.child('uid').val() === auth.uid && ((newData.child('status').val() === 'pending' && root.child('weeks/'+$w+'/cfg/phase').val() === 'request' && newData.child('dur').val() <= root.child('weeks/'+$w+'/cfg/maxSlots').val()) || (newData.child('status').val() === 'confirmed' && root.child('weeks/'+$w+'/cfg/phase').val() === 'free' && newData.child('e').val() - newData.child('s').val() <= root.child('weeks/'+$w+'/cfg/maxSlots').val()))) || (data.exists() && data.child('uid').val() === auth.uid && (!newData.exists() || (data.child('status').val() === 'pending' && newData.child('status').val() === 'pending' && newData.child('uid').val() === auth.uid && newData.child('dur').val() <= root.child('weeks/'+$w+'/cfg/maxSlots').val()))))",
            ".validate": "newData.hasChildren(['uid','rep','kind','day','s','e','dur','status','createdAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val().length < 64"
            },
            "band": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "rep": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "kind": {
              ".validate": "newData.val() === 'band' || newData.val() === 'drum' || newData.val() === 'other'"
            },
            "day": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6 && newData.val() % 1 === 0"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 24 && newData.val() % 1 === 0"
            },
            "e": {
              ".validate": "newData.isNumber() && newData.val() <= 24 && newData.val() > newData.parent().child('s').val() && newData.val() % 1 === 0"
            },
            "dur": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= newData.parent().child('e').val() - newData.parent().child('s').val()"
            },
            "status": {
              ".validate": "newData.val() === 'pending' || newData.val() === 'confirmed' || newData.val() === 'rejected'"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "ws": {
              ".validate": "newData.isNumber()"
            },
            "we": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "slots": {
          "$k": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && (auth.token.email === 'unei@kitami-keion.example' || (root.child('weeks/'+$w+'/cfg/phase').val() === 'free' && newData.parent().parent().child('reqs/'+newData.val()+'/uid').val() === auth.uid))) || (data.exists() && !newData.exists() && (auth.token.email === 'unei@kitami-keion.example' || root.child('weeks/'+$w+'/reqs/'+data.val()+'/uid').val() === auth.uid)))",
            ".validate": "newData.isString() && $k.matches(/^[0-6]_([0-9]|1[0-9]|2[0-3])$/)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "liveIdx": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'",
        ".validate": "newData.hasChildren(['name','date'])"
      }
    },
    "tpls": {
      ".read": true,
      "$t": {
        ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },
    "lives": {
      ".read": true,
      "$id": {
        "cfg": {
          ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'",
          ".validate": "newData.hasChildren(['name','date','open'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "items": {
          ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'"
        },
        "run": {
          ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'"
        },
        "checks": {
          "$k": {
            ".write": "auth != null && root.child('lives/'+$id+'/cfg').exists()",
            "out": {
              ".validate": "newData.isBoolean()"
            },
            "back": {
              ".validate": "newData.isBoolean()"
            },
            "$o": {
              ".validate": false
            }
          }
        },
        "entries": {
          "$e": {
            ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (root.child('lives/'+$id+'/cfg').exists() && root.child('lives/'+$id+'/cfg/locked').val() !== true && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && (!newData.exists() || newData.child('uid').val() === auth.uid)))))",
            ".validate": "newData.hasChildren(['uid','band','createdAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val().length < 64"
            },
            "band": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 400"
            }
          }
        },
        "$o": {
          ".validate": false
        },
        ".write": "auth != null && auth.token.email === 'unei@kitami-keion.example'"
      }
    },
    "supplies": {
      ".read": true,
      "$s": {
        ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'new') || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid && data.child('status').val() === 'new'))",
        ".validate": "newData.hasChildren(['uid','item','status','createdAt'])",
        "item": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "who": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "status": {
          ".validate": "newData.val() === 'new' || newData.val() === 'seen' || newData.val() === 'ordered' || newData.val() === 'done'"
        }
      }
    },
    "tierTopics": {
      ".read": true,
      "$t": {
        ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['name','by','uid','createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid || auth.token.email === 'unei@kitami-keion.example'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tierItems": {
      ".read": true,
      "$t": {
        ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (!newData.exists() && !newData.parent().parent().child('tierTopics/'+$t).exists()))",
        "$i": {
          ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (!data.exists() && newData.child('uid').val() === auth.uid && root.child('tierTopics/'+$t).exists()) || (data.exists() && !newData.exists()))",
          ".validate": "newData.hasChildren(['t','uid','createdAt'])",
          "t": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "tierLists": {
      ".read": true,
      "$t": {
        ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || (!newData.exists() && !newData.parent().parent().child('tierTopics/'+$t).exists()))",
        "$l": {
          ".write": "auth != null && (auth.token.email === 'unei@kitami-keion.example' || ($l === auth.uid && (!newData.exists() || root.child('tierTopics/'+$t).exists())))",
          ".validate": "newData.hasChildren(['who','uid','createdAt','updatedAt']) && newData.child('uid').val() === $l",
          "who": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "r": {
            "$i": {
              ".validate": "newData.val() === 'S' || newData.val() === 'A' || newData.val() === 'B' || newData.val() === 'C' || newData.val() === 'D'"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
